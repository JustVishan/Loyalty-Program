# Database — Supabase direct connection string
# Get from: Supabase Dashboard → Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# JWT — generate a strong random string (min 32 chars)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Server
PORT=3000
NODE_ENV=production

# CORS — set to your Vercel frontend URL in production
# e.g. https://rewardhub.vercel.app
CORS_ORIGIN=http://localhost:5173

# 2FA issuer name (shows in Google Authenticator)
TOTP_ISSUER=RewardHub
